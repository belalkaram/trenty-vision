NODE_ENV=development
PORT=3000
HOST=0.0.0.0
APP_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# JWT Secrets
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_chars
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_chars

# Encryption Key (64-character hex string for AES-256-GCM)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Cookie Secret
COOKIE_SECRET=your_cookie_secret_min_32_chars

# Company defaults
DEFAULT_COMPANY_NAME=Kenooz
DEFAULT_TIMEZONE=Asia/Kuwait

# Storage
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage/uploads

# Logging
LOG_LEVEL=info

# Landing Page Sync (Trinity Vision)
LANDING_SYNC_ENABLED=true
LANDING_SYNC_URL=https://trintyvision.com/landing/api/submit.php
