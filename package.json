{
  "name": "trenty-vision-whatsapp-crm",
  "version": "1.0.0",
  "description": "Internal Mobile-first WhatsApp CRM for Trenty Vision Health Care",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:client": "vite --config frontend/vite.config.ts frontend",
    "build": "npm run build:client && npm run build:css && tsc",
    "build:client": "vite build --config frontend/vite.config.ts frontend",
    "build:css": "tailwindcss -i ./src/views/css/input.css -o ./public/css/app.css --minify",
    "watch:css": "tailwindcss -i ./src/views/css/input.css -o ./public/css/app.css --watch",
    "start": "node dist/server.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/database/migrate.ts",
    "db:seed": "tsx src/database/seed.ts",
    "bridge": "tsx baileys-bridge/server.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "whatsapp",
    "crm",
    "healthcare",
    "fastify",
    "typescript",
    "drizzle",
    "postgresql",
    "pwa"
  ],
  "author": "Trenty Vision",
  "license": "ISC",
  "dependencies": {
    "@fastify/cookie": "^9.4.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/formbody": "^7.4.0",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/static": "^7.0.4",
    "@fastify/view": "^8.2.0",
    "@fastify/websocket": "^10.0.1",
    "@tanstack/react-query": "^5.102.8",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.36.4",
    "eta": "^3.4.0",
    "fastify": "^4.28.1",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^1.43.0",
    "node-cron": "^3.0.3",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.3",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.8.4",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.11.10",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.28.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.4"
  }
}
